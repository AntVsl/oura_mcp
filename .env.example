# Шаблон конфигурации. Скопируй в .env и заполни.
#   cp .env.example .env
# Реальный .env в git не попадает (см. .gitignore).

# --- Учётные данные приложения Oura ---------------------------------------
# Берутся со страницы приложения: https://developer.ouraring.com/applications
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=

# Должен ПОСИМВОЛЬНО совпадать с Redirect URI, вписанным в приложении Oura.
# Порт, схема и завершающий слэш имеют значение.
OURA_REDIRECT_URI=http://localhost:8765/callback

# --- Режим работы ----------------------------------------------------------
# sandbox    — тестовые данные Oura, авторизация не нужна
# production — твои реальные данные, требуется OAuth
OURA_API_MODE=sandbox

# Часовой пояс для трактовки «сегодня» / «вчера».
# Локально можно не трогать; на сервере (UTC) задать обязательно.
OURA_TZ=Europe/Moscow

# --- Пути (по умолчанию рядом с проектом) ---------------------------------
# Сюда OAuth-флоу запишет access/refresh токены. Руками не заполнять.
OURA_TOKEN_STORE=.oura/tokens.json
OURA_CACHE_DB=.oura/cache.db

# --- Только для удалённого развёртывания ----------------------------------
# Общий секрет, которым Claude авторизуется на HTTP-эндпоинте. Без него
# сервер откажется слушать на внешнем адресе.
# Сгенерировать:  python3 -c "import secrets;print(secrets.token_urlsafe(32))"
OURA_MCP_TOKEN=

# Домен, на который Caddy выпустит TLS-сертификат. A-запись должна вести
# на этот сервер ДО первого запуска compose.
OURA_DOMAIN=

# Публичный адрес сервера. Заполнен — включается OAuth 2.1, и сервер можно
# подключить к claude.ai (в том числе с айфона). Пуст — работает только общий
# секрет выше, чего хватает для Claude Code, но не для веба.
#
# Без хвостового слэша и только https: по этому адресу ходят коды авторизации
# и токены, а ещё он попадает в метаданные OAuth и должен совпадать с тем, что
# вводится в claude.ai, посимвольно.
OURA_PUBLIC_URL=
