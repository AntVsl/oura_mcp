# Шаблон конфигурации. Скопируй в .env и заполни.
#   cp .env.example .env
# Реальный .env в git не попадает (см. .gitignore).

# --- Учётные данные приложения Oura ---------------------------------------
# Берутся со страницы приложения: https://developer.ouraring.com/applications
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=

# Должен ПОСИМВОЛЬНО совпадать с Redirect URI, вписанным в приложении Oura.
# Порт, схема и завершающий слэш имеют значение.
OURA_REDIRECT_URI=http://localhost:8765/callback

# --- Режим работы ----------------------------------------------------------
# sandbox    — тестовые данные Oura, авторизация не нужна
# production — твои реальные данные, требуется OAuth
OURA_API_MODE=sandbox

# Часовой пояс для трактовки «сегодня» / «вчера». Замени UTC на свой IANA-пояс
# (например Europe/Moscow); на сервере это обязательно.
OURA_TZ=UTC

# --- Пути (по умолчанию относительно текущего каталога) --------------------
# Сюда OAuth-флоу запишет access/refresh токены. Руками не заполнять.
OURA_TOKEN_STORE=.oura/tokens.json
OURA_CACHE_DB=.oura/cache.db

# --- Только для удалённого развёртывания ----------------------------------
# Общий секрет для CLI-клиентов (Claude Code, Codex) на HTTP-эндпоинте. Без
# него сервер откажется слушать на внешнем адресе.
# Сгенерировать:  python3 -c "import secrets;print(secrets.token_urlsafe(32))"
OURA_MCP_TOKEN=

# Домен, на который Caddy выпустит TLS-сертификат. A-запись должна вести
# на этот сервер ДО первого запуска compose.
OURA_DOMAIN=

# Публичный адрес сервера. Заполнен — включается OAuth 2.1, и сервер можно
# подключить к Claude.ai и ChatGPT. Пуст — работает только общий секрет выше,
# чего хватает для Claude Code и Codex, но не для веб-клиентов.
#
# Без хвостового слэша и только https: по этому адресу ходят коды авторизации
# и токены, а ещё он попадает в метаданные OAuth и должен совпадать с тем, что
# вводится в веб-клиенте, посимвольно.
OURA_PUBLIC_URL=

# Origins OAuth-клиентов, которым разрешена динамическая регистрация. По
# умолчанию разрешены Claude.ai и ChatGPT. Добавляй другой origin только для
# клиента, которому доверяешь и чьи redirect URI контролируешь.
OURA_OAUTH_ALLOWED_REDIRECT_ORIGINS=https://claude.ai,https://chatgpt.com

# Токен туннеля Cloudflare — нужен только для compose.tunnel.yml. Берётся при
# создании туннеля в панели (Zero Trust → Networks → Tunnels): длинная строка
# после --token в показанной там команде.
#
# Туннель нужен, если светить IP сервера нельзя, — например на хосте с VPN:
# портов наружу не открывается вообще, и адрес не попадает в публичный лог
# сертификатов. Иначе проще взять compose.caddy.yml и OURA_DOMAIN выше.
CLOUDFLARE_TUNNEL_TOKEN=
